{
  "name": "dsh-team-dev",
  "version": "0.4.1",
  "description": "给 DeepSeek Harness 加一支开发团队：v0.4 起随包 team-dev 采用短路由 + references（L0 契约、质量门、交付面、项目规则发现），含 team-boot、每个 agent 的步数预算守卫、Web 右侧只读团队看板（多团队切换与筛选），以及跨 agent 的会话级改动账本；零运行时依赖，适配 DSH 0.2.2 的 Agent Teams。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./session-changes": "./lib/session-changes.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/session-changes.js",
    "lib/client.js",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "export": "node scripts/export-to-harness.mjs",
    "verify": "node scripts/verify.mjs",
    "pack": "pnpm pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JieCore/dsh-team-dev.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/JieCore/dsh-team-dev#readme",
  "bugs": {
    "url": "https://github.com/JieCore/dsh-team-dev/issues"
  }
}
