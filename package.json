{
  "name": "dsh-team-dev",
  "version": "0.2.2",
  "description": "Self-contained Dev Team bundle for DeepSeek Harness: a per-agent step-budget guard, bundled team-dev/team-boot skills with built-in engineering guidelines, and a read-only team board in the Web UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "export": "node scripts/export-to-harness.mjs",
    "verify": "node scripts/verify.mjs",
    "pack": "pnpm pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JieCore/dsh-team-dev.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/JieCore/dsh-team-dev#readme",
  "bugs": {
    "url": "https://github.com/JieCore/dsh-team-dev/issues"
  }
}
